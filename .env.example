# Copy to .env for running apps on the host (pnpm dev). Compose sets its own
# in-network values for the containers, so it does not read these.

# Docker Compose reads these for the postgres/rabbitmq passwords and the containers' connection URLs.
# The defaults below are for local development only: change them before running anywhere else, and
# before the first start (Postgres reads its password only when it creates its volume; `docker compose
# down -v` resets). A password used in a URL must be URL-encoded. They are not used by the host-run
# DATABASE_URL / RABBITMQ_URL below, which you must keep in step by hand.
# POSTGRES_USER=alteva
# POSTGRES_PASSWORD=alteva_password
# POSTGRES_DB=alteva_db
# RABBITMQ_USER=alteva
# RABBITMQ_PASSWORD=alteva_password

# Host-side ports: postgres 5442, rabbitmq 5672 (UI on 15672).
DATABASE_URL=postgres://alteva:alteva_password@localhost:5442/alteva_db
RABBITMQ_URL=amqp://alteva:alteva_password@localhost:5672

# Browser origins the api accepts cross-origin calls from (comma separated).
# 3000 is `pnpm dev`; 3100 is the web container from docker compose.
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# Web app (apps/web): api address as the browser sees it. Inlined at build time, so set it in
# apps/web/.env.local for `pnpm dev`, or as a build arg (docker-compose.yml does this).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Crawl defaults
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=200
# A job still unfinished after this many minutes is marked Failed (checked every minute by the api).
JOB_TIMEOUT_MINUTES=30

LOG_LEVEL=info
