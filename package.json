{
  "name": "alteva",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @alteva/web dev",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test:integration": "docker compose up -d --wait postgres && REQUIRE_DB=1 pnpm -r test",
    "build:services": "pnpm --filter @alteva/api build && pnpm --filter @alteva/worker build"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
