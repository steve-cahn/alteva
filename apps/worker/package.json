    "start:prod": "node --enable-source-maps dist/index.mjs"
  },
  "dependencies": {
    "@alteva/core": "workspace:*",
    "amqplib": "^2.3.1",
    "pg": "^8.23.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
