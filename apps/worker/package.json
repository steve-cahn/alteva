{
  "name": "@alteva/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "fixtures": "tsx test/serve-fixtures.ts",
